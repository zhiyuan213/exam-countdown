# ============================================================
# 构建产物
# ============================================================
target/
backend/target/
*.jar

# ============================================================
# 恢复过程中的中间产物（体积大 / 可重新生成）
# ============================================================
# 3159 个 9KB 分片
recover/parts/
# Vineflower / CFR 反编译器，可按需重新下载
recover/tools/
recover/selftest/
**/__pycache__/
*.pyc

# 线上原始 jar：内嵌的 application.yml 含真实密钥，默认不入库。
# 轮换全部凭据之后，删掉下面这一行即可一并入库（29MB，GitHub 单文件上限 100MB）
recover/app.jar

