<template name="nodeItem">
  <view
    class="node {{node.passed ? 'node--passed' : ''}} {{highlightId === node.id ? 'node--highlight' : ''}}"
    hover-class="node--tap"
    hover-stay-time="80"
    data-id="{{node.id}}"
    data-name="{{node.name}}"
    data-iscustom="{{node.isCustom}}"
    data-templateid="{{node.templateId}}"
    bindtap="onNodeTap"
    bindlongpress="onNodeLongpress"
  >
    <view class="node-main">
      <view class="node-head">
        <text class="badge">{{node.nodeLabel}}</text>
        <text class="node-name">{{node.name}}</text>
      </view>
      <view class="node-date">{{node.examDate}}</view>
    </view>

    <view class="node-right">
      <view class="countdown">{{node.daysLabel}}</view>
      <view class="btn-row">
        <!-- 只作状态展示，点击交给整行 onNodeTap，避免按钮字太小不好点 -->
        <view
          wx:if="{{!node.passed}}"
          class="sub-pill {{subscribedMap[node.id] ? 'is-subscribed' : ''}}"
        >{{subscribedMap[node.id] ? '已订阅' : '订阅提醒'}}</view>
      </view>
    </view>
    <text class="chevron">›</text>
  </view>
</template>

<view
  class="container"
  bindtouchstart="onTouchStart"
  bindtouchmove="onTouchMove"
  bindtouchend="onTouchEnd"
>

  <!-- 自定义下拉刷新区（京东样式：随下拉距离动态变化） -->
  <view wx:if="{{pullH > 0}}" class="pull-zone {{dragging ? 'dragging' : ''}}" style="height:{{pullH}}px">
    <!-- 下拉刷新图标：随下拉距离左转，拉到底正好转满一圈；松手自动回正 -->
    <image
      class="pull-icon {{refreshing ? 'spinning' : ''}}"
      src="/images/calendar-red.png"
      style="{{refreshing ? '' : 'transform: rotate(' + pullRotate + 'deg)'}}"
    />
    <text class="pull-text">{{pullText}}</text>
  </view>

  <view class="hero">
    <image class="hero-icon" src="/images/calendar-red.png" />
    <view class="hero-text">
      <text class="hero-title">考试倒计时</text>
      <text class="hero-sub">每一次努力，都在靠近梦想</text>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading">加载中…</view>

  <view wx:elif="{{errorMsg}}" class="empty">{{errorMsg}}</view>

  <block wx:else>
    <view class="group group--subs">
      <view class="group-head">
        <text class="group-title">消息清单</text>
        <text class="group-hint">{{subList.length ? '共 ' + subList.length + ' 条' : ''}}</text>
      </view>

      <view wx:if="{{subList.length === 0}}" class="mine-empty">还没有订阅，点下方节点的「订阅提醒」后会出现在这里</view>

      <view
        wx:for="{{subList}}"
        wx:key="id"
        class="sub-row {{item.urgent ? 'sub-row--urgent' : ''}} {{item.passed ? 'sub-row--passed' : ''}}"
      >
        <view class="sub-main">
          <view class="sub-head">
            <text class="badge">{{item.nodeLabel}}</text>
            <text class="sub-name">{{item.name}}</text>
            <text class="sub-deadline">截止 {{item.examDate}}</text>
          </view>
          <view class="sub-date">
            <view>提醒剩余 {{item.remainTimes}} 次</view>
            <view wx:for="{{item.pushTimes}}" wx:for-item="t" wx:key="*this">{{t}}</view>
          </view>
        </view>
        <text class="days-pill {{item.urgent ? 'days-pill--urgent' : ''}}">{{item.daysLabel}}</text>
      </view>
    </view>

    <view class="group group--mine">
      <view class="group-head">
        <text class="group-title">设置提醒</text>
        <text class="group-hint">{{quotaText || '免费 3 个'}}</text>
        <text class="quota-buy" bindtap="onBuyQuota">额度包 ›</text>
      </view>

      <block wx:for="{{customNodes}}" wx:for-item="node" wx:key="id">
        <template is="nodeItem" data="{{node: node, highlightId: highlightId, subscribedMap: subscribedMap}}" />
      </block>

      <button class="add-entry {{quotaRemaining <= 0 ? 'add-entry--full' : ''}}" bindtap="onAdd">{{quotaRemaining <= 0 ? '额度已满 · 购买额度包' : '＋ 添加提醒'}}</button>
    </view>

    <view wx:for="{{groups}}" wx:key="groupCode" class="group">
      <view class="group-title">{{item.groupName}}</view>

      <block wx:for="{{item.nodes}}" wx:for-item="node" wx:key="id">
        <template is="nodeItem" data="{{node: node, highlightId: highlightId, subscribedMap: subscribedMap}}" />
      </block>
    </view>

    <view wx:if="{{groups.length === 0}}" class="empty">暂无上架节点</view>
  </block>

</view>
