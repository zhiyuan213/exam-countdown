.group {
  margin-bottom: 32rpx;
}

/* ============ 自定义下拉刷新（京东样式） ============ */
.pull-zone {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  overflow: hidden;
  transition: height 0.25s ease;
}

/* 手指拖动中：高度跟手，不带过渡 */
.pull-zone.dragging {
  transition: none;
}

/* 下拉刷新图标：舞台固定大于图标对角线（56 × √2 ≈ 79rpx），旋转不裁角、不缩放 */
.pull-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 2rpx;
}

.pull-icon {
  width: 56rpx;
  height: 56rpx;
  transition: transform 0.3s ease;
}

/* 手指拖动中：角度跟手，不带过渡 */
.pull-zone.dragging .pull-icon {
  transition: none;
}

/* 刷新中：持续左转（loading 反馈） */
.pull-icon.spinning {
  animation: pull-spin 0.9s linear infinite;
}

@keyframes pull-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(-360deg); }
}

/* 下拉提示文字：只换文案，字号/颜色/大小均保持不变 */
.pull-text {
  font-size: 24rpx;
  color: #7d93b5;
  padding-bottom: 14rpx;
}

.btn-row {
  display: flex;
  align-items: center;
}

.group-title {
  position: relative;
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  padding: 8rpx 8rpx 16rpx 26rpx;
}

/* 标题左侧蓝色竖条 */
.group-title::before {
  content: '';
  position: absolute;
  left: 4rpx;
  top: 50%;
  transform: translateY(-40%);
  width: 8rpx;
  height: 30rpx;
  background: #4a90e2;
  border-radius: 4rpx;
}

/* 右侧箭头 */
.chevron {
  font-size: 36rpx;
  color: #c3cbd8;
  margin-left: 8rpx;
  flex-shrink: 0;
  line-height: 1;
}

/* 顶部品牌区 */
.hero {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #dcecfc 0%, #eef5fe 60%, rgba(238, 245, 254, 0) 100%);
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 24rpx;
}

.hero-icon {
  width: 52rpx;
  height: 52rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.hero-text {
  display: flex;
  flex-direction: column;
}

.hero-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #2c5aa0;
}

.hero-sub {
  font-size: 22rpx;
  color: #7d93b5;
  margin-top: 6rpx;
}

.group-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.group-head .group-title {
  padding-bottom: 8rpx;
}

.group-hint {
  font-size: 22rpx;
  color: #8a94a6;
  padding-right: 8rpx;
  margin-left: auto;   /* 与「额度包 ›」一起靠右 */
}

.mine-empty {
  font-size: 24rpx;
  color: #a2aab8;
  padding: 8rpx 8rpx 16rpx;
}

/* 消息清单：已订阅节点的汇总列表（与下方节点卡片统一高度） */
.sub-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  min-height: 148rpx;
  box-sizing: border-box;
  box-shadow: 0 2rpx 8rpx rgba(74, 144, 226, 0.06);
}

.sub-row--passed {
  opacity: 0.5;
}

.sub-main {
  flex: 1;
  min-width: 0;
}

.sub-head {
  display: flex;
  align-items: center;
}

.sub-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-left: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sub-deadline {
  flex-shrink: 0;
  margin-left: 12rpx;
  font-size: 24rpx;
  color: #a2aab8;
}

.sub-date {
  font-size: 24rpx;
  color: #9099a8;
  margin-top: 10rpx;
  line-height: 1.4;
}

/* 倒计时胶囊：消息清单用，紧急红色 */
.days-pill {
  font-size: 28rpx;
  font-weight: 600;
  color: #4a90e2;
  background: #eaf3fd;
  border-radius: 24rpx;
  padding: 6rpx 20rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.days-pill--urgent {
  color: #e94f4f;
  background: #fdecec;
}

.add-entry {
  display: block !important;
  width: 100% !important;
  box-sizing: border-box !important;
  font-size: 26rpx !important;
  line-height: 2.6 !important;
  background: #fff !important;
  color: #4a90e2 !important;
  border: 1rpx dashed #9cc3f0 !important;
  border-radius: 40rpx !important;
  margin: 8rpx 0 24rpx !important;
}

.add-entry::after {
  border: none;
}

/* 额度已满时按钮变成购买入口 */
.add-entry--full {
  color: #e98b1f !important;
  border-color: #f0c893 !important;
  background: #fffaf2 !important;
}

/* 设置提醒分组标题右侧的「额度包」入口 */
.quota-buy {
  font-size: 22rpx;
  color: #4a90e2;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.node {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border-left: 6rpx solid #7fb2e8;
  min-height: 148rpx;
  box-sizing: border-box;
  box-shadow: 0 2rpx 8rpx rgba(74, 144, 226, 0.06);
}

.node--passed {
  opacity: 0.5;
}

.node--highlight {
  box-shadow: 0 0 0 3rpx #4a90e2 inset;
}

/* 整行可点：按下时的反馈 */
.node--tap {
  background: #f5f9fe;
}

.node-main {
  flex: 1;
  min-width: 0;
}

.node-head {
  display: flex;
  align-items: center;
}

.badge {
  font-size: 20rpx;
  color: #4a90e2;
  background: #eaf3fd;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.node-name {
  font-size: 30rpx;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.node-date {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}

.node-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.countdown {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

/* 订阅状态胶囊：纯展示，点击由整行接管（行可点区域更大） */
.sub-pill {
  font-size: 24rpx;
  line-height: 1.8;
  padding: 0 22rpx;
  background: #4a90e2;
  color: #fff;
  border-radius: 30rpx;
  white-space: nowrap;
}

.sub-pill.is-subscribed {
  background: #e8eef6;
  color: #7a8ba6;
}
